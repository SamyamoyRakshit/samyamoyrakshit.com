# https://editorconfig.org
# Applied by the editor before Prettier ever runs, so a file opened in an
# editor with different defaults does not arrive pre-mangled.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false
