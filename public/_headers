# Response headers for Netlify and Cloudflare Pages.
# (Vercel reads vercel.json instead — keep the two in sync.)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# Note on 'unsafe-inline' in script-src: the theme is applied by a small inline
# script that must run before first paint, and a static site has no server to
# mint a per-request nonce. The policy still blocks every external script
# origin, which is the attack this site is realistically exposed to. If that
# ever stops being good enough, move to hash-based CSP.

# Fonts and images are content-hashed by the build, so they can be cached hard.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og/*
  Cache-Control: public, max-age=31536000, immutable
