---
import ThemeToggle from './ThemeToggle.astro';
import { identity, nav, features, filled } from '../config/site';
import { getWork, getBlogPosts } from '../lib/content';

/**
 * The masthead bar. Sticky, because the homepage runs ~4,500px and
 * /experience/ ~5,000px — without it a reader at the foot of either has to
 * scroll the whole way back for the navigation or the theme toggle.
 *
 * Sticky, not clever: no hide-on-scroll-down, which needs JavaScript, and no
 * frosted backdrop, which this design rules out. A solid `--paper` ground is
 * what keeps text legible as it passes underneath.
 *
 * Routes with no content hide themselves, so the navigation never promises a
 * page that isn't there.
 *
 * The identity is set as type, not drawn. The monogram exists as the tab icon,
 * but beside a name already spelled out it states the same thing twice, and it
 * would be the only boxed element in a bar built from one hairline. Where the
 * full name will not fit, the first name stands in.
 *
 * Below 30rem the links collapse behind a "Menu" button, because they cannot
 * share a line with the name: measured at 360px the three labels and the
 * theme toggle come to 279px and the wordmark to 72px, against 320px of
 * content width. Every way of shrinking them to fit lands within a few pixels
 * of the limit and breaks again on a 320px screen.
 *
 * Worth knowing that this is a considered trade rather than the default: with
 * three destinations the research runs the other way. NN/g put the threshold
 * at four links or fewer shown, and measured hidden navigation costing over
 * 20% of discoverability. The alternative built here first was two visible
 * rows, which is what the site owner looked at and rejected. Two things pay
 * some of that cost back — the button is labelled with the word "Menu", which
 * measures better than three bare lines, and the panel is a real disclosure
 * rather than a hidden drawer.
 *
 * If the bar ever loses the theme toggle, re-measure: the links alone fit on
 * one line at 360px and the button stops being necessary.
 */

const [work, posts] = await Promise.all([getWork(), getBlogPosts()]);

const available = new Set<string>();
available.add('/experience/');
if (features.work && work.length > 0) available.add('/projects/');
if (features.blog && posts.length > 0) available.add('/blog/');

/**
 * The résumé sits in the navigation rather than buried in the footer, because
 * a recruiter looks for it in exactly one place and this is it. It appears the
 * moment `identity.resumeUrl` points at something — drop a PDF in `public/`.
 */
const resume = filled(identity.resumeUrl);

const links: { label: string; href: string }[] = [
  ...nav.filter((item) => available.has(item.href)),
  ...(resume ? [{ label: 'Résumé', href: resume }] : []),
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="masthead-bar">
  <div class="shell masthead-bar__inner">
    {
      /* The full name, on every page including the homepage. It is set twice on
        the homepage — once here, once as the <h1> — and that is fine. Anything
        cleverer in this slot reads as a rendering fault. */
    }
    <a href="/" class="wordmark label" aria-label={`${identity.name} — home`}>
      <span class="wordmark__full">{identity.name}</span>
      <span class="wordmark__short" aria-hidden="true">{identity.shortName}</span>
    </a>

    {
      /* Labelled "Menu", not three bare lines. Unlabelled hamburgers measure
        worse for first-time visitors and for anyone over about 40, and the
        word costs 34px on a row with 112px to spare.

        No `hidden` attribute and no JavaScript needed to render it correctly:
        CSS shows this only when `data-js` is on <html>, which the pre-paint
        script in BaseHead sets. Without JavaScript the button never appears
        and the links stay visible in two rows — the fallback is the finished
        page, not a dead end. */
    }
    <button
      id="nav-toggle"
      type="button"
      class="nav-toggle label"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <svg
        class="nav-toggle__icon nav-toggle__icon--open"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"></path>
      </svg>
      <svg
        class="nav-toggle__icon nav-toggle__icon--close"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path>
      </svg>
      <span>Menu</span>
    </button>

    <nav aria-label="Primary" class="masthead-bar__nav" id="primary-nav">
      <ul class="nav">
        {
          links.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav__link label"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /* Outside the list on purpose. Changing the theme is not a destination,
        so it does not belong among the links a screen reader is offered when
        it enumerates the primary navigation — and keeping it a sibling is what
        lets it move to the end of the first row when the bar wraps. */
    }
    {
      features.themeToggle && (
        <div class="masthead-bar__toggle">
          <ThemeToggle />
        </div>
      )
    }
  </div>
</header>

<style>
  .masthead-bar {
    position: sticky;
    top: 0;
    /* Above the cards, below the skip link (z-index 100 in global.css). */
    z-index: 20;
    /* Opaque, not translucent. Content scrolls underneath this. */
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  /* Three siblings — wordmark, nav, toggle. The wordmark holds the left and
     `margin-left: auto` on the nav pushes the other two to the right end, so
     the row survives the wrap below without either of them needing a wrapper
     to group them. */
  .masthead-bar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem clamp(1rem, 0.4rem + 2vw, 2.25rem);
    padding-block: 0.35rem;
    /* Kept in step with --header-h, which scroll-padding-top is derived from.
       --header-h grows at the same breakpoint the bar wraps at — see the
       media query in global.css — so a deep link never parks its heading
       underneath a bar that turned out to be taller than the offset. */
    min-height: var(--header-h);
  }

  .masthead-bar__nav {
    margin-left: auto;
  }

  .masthead-bar__toggle {
    display: flex;
  }

  /* Hidden everywhere except a phone with JavaScript — see the media query at
     the foot of this file. */
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.15rem;
    background: none;
    border: 0;
    color: var(--ink-muted);
    cursor: pointer;
    transition: color var(--dur-hover) var(--ease);
  }
  .nav-toggle:hover {
    color: var(--accent);
  }

  .nav-toggle__icon--close {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--open {
    display: none;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle__icon--close {
    display: block;
  }

  /* A hairline is enough separation while the page is at rest, and at the top
     of the homepage it is the right amount — the bar should sit flush against
     the hero, not float above it. Once the page has moved, text passing under
     a 1px line on the same ground reads as clipped rather than layered, so the
     bar earns a soft edge.

     Carried on a pseudo-element and animated as opacity, because only
     transform and opacity are ever animated here — a box-shadow keyframe would
     repaint the bar on every frame of a scroll. Progressive enhancement: the
     un-animated state is the plain hairline, which is complete and correct, so
     Firefox (no scroll timelines in stable) gets a finished header. */
  .masthead-bar::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 1px;
    box-shadow: var(--shadow-card);
    opacity: 0;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .masthead-bar::after {
        /* The duration is nominal — a scroll timeline drives progress from the
           range below, not from a clock — but it MUST be written, and it must
           be a `var()`.

           The CSS minifier folds `animation-timeline` into the `animation`
           shorthand whenever it can resolve every part of it, emitting
           `animation: linear both bar-edge scroll(root)`. `animation-timeline`
           is not a component of that shorthand — it was in an early draft and
           was removed — so the browser discards the whole declaration and the
           animation silently never runs. A literal duration does not help;
           `auto` is dropped and the fold still happens. A custom property
           cannot be resolved at build time, so the minifier leaves both
           declarations alone. This is exactly why `.reveal` in global.css
           works and a hand-written copy of it would not. */
        animation: bar-edge var(--dur-reveal) linear both;
        animation-timeline: scroll(root block);
        /* Fully on by the time the hero's first line has left the viewport. */
        animation-range: 0 6rem;
      }
    }
  }

  @keyframes bar-edge {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .wordmark {
    color: var(--ink);
    letter-spacing: 0.18em;
    transition: color var(--dur-hover) var(--ease);
    padding-block: 0.5rem;
  }
  .wordmark:hover {
    color: var(--accent);
  }

  .wordmark__short {
    display: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.4rem + 2vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.9rem;
    color: var(--ink-muted);
    transition: color var(--dur-hover) var(--ease);
  }
  .nav__link:hover {
    color: var(--accent);
  }

  /* The current page is marked with a rule, not a colour — the accent stays
     reserved for things you can act on. */
  .nav__link[aria-current='page'] {
    color: var(--ink);
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: var(--ink);
  }

  /* Two breakpoints, not one, because the bar has three states and the widths
     they change at are 2rem apart.

     Measured in JetBrains Mono at the `.label` size, which has a fixed 0.6em
     advance, so these are arithmetic rather than guesses. The full name plus
     the links plus the toggle come to 442px and need a 512px viewport once the
     gutter is taken off; the first name plus the same needs 412px, which is a
     width real phones actually are. So the first name takes over at 32rem —
     where the full one stops fitting — and the wrap happens at 30rem, far
     enough below 412px that no phone lands within a few pixels of the edge. */
  @media (max-width: 32rem) {
    .wordmark__full {
      display: none;
    }
    .wordmark__short {
      display: inline;
    }
  }

  @media (max-width: 30rem) {
    .masthead-bar__inner {
      padding-block: 0;
      row-gap: 0;
    }

    /* Theme first, menu at the far right where a thumb expects it. */
    .masthead-bar__toggle {
      order: 2;
      margin-left: auto;
    }
    .nav-toggle {
      order: 3;
    }
    .masthead-bar__nav {
      order: 4;
      flex-basis: 100%;
      margin-left: 0;
    }

    :root[data-js] .nav-toggle {
      display: inline-flex;
    }

    /* Collapsed only when there is a button to open it again. */
    :root[data-js] .masthead-bar__nav {
      display: none;
    }
    :root[data-js] .masthead-bar[data-open] .masthead-bar__nav {
      display: block;
      border-top: 1px solid var(--rule);
    }

    /* Open, the links stack as full-width rows — the whole width is the tap
       target, which is the point of opening a panel at all. Without
       JavaScript this same block lays them out in a row across the bar. */
    :root[data-js] .nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-bottom: 0.4rem;
    }
    :root[data-js] .nav__link {
      display: block;
      padding-block: 0.85rem;
    }

    /* No JavaScript: two rows, and the links spread to both margins so the
       row reads as composed rather than as an overflow. */
    :root:not([data-js]) .nav {
      justify-content: space-between;
    }
  }
</style>

<script>
  /**
   * The phone menu.
   *
   * Everything here is an addition to a page that already works: the button
   * only exists because `data-js` is set before paint, and the panel is only
   * collapsed under the same condition. If this script fails to run, the
   * links are simply visible.
   *
   * `aria-expanded` on the button is the single source of truth for the state
   * — the icon swap and the panel both key off it — so there is no second
   * copy to fall out of step.
   */
  function initNav() {
    const bar = document.querySelector<HTMLElement>('.masthead-bar');
    const button = document.getElementById('nav-toggle');
    if (!bar || !button) return;

    const isOpen = () => button.getAttribute('aria-expanded') === 'true';

    const close = () => {
      bar.removeAttribute('data-open');
      button.setAttribute('aria-expanded', 'false');
    };

    const open = () => {
      bar.setAttribute('data-open', '');
      button.setAttribute('aria-expanded', 'true');
    };

    button.addEventListener('click', () => (isOpen() ? close() : open()));

    // Escape is the expected way out of anything that opened over the page.
    // Focus goes back to the button, otherwise it is left nowhere.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        close();
        button.focus();
      }
    });

    // Tapping a link normally navigates and the panel goes with the page. It
    // does not when the target is the page you are already on, which would
    // otherwise leave the panel sitting open over the answer.
    for (const link of bar.querySelectorAll('.nav__link')) {
      link.addEventListener('click', close);
    }

    // Rotating to landscape can cross the breakpoint, which would strand the
    // panel open with no button left to close it.
    const wide = window.matchMedia('(min-width: 30.0625rem)');
    wide.addEventListener('change', () => {
      if (wide.matches) close();
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
