---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import {
  identity,
  intro,
  availability,
  features,
  filled,
  activeSocials,
} from '../config/site';

/**
 * The hero: name, role, statement, two buttons, social icons and a portrait.
 *
 * The figure is a photograph rather than a generated diagram. A face is the
 * fastest thing a stranger has for deciding a real person is behind a page.
 *
 * The source frame is a formal headshot on a pure white ground, which would
 * dissolve into a near-white card, so it sits on a tinted panel with a solid
 * accent block offset behind it. The white background then reads as part of
 * the composition rather than as a missing cut-out.
 */

const role = filled(identity.role);
const location = filled(identity.location);
const statement = filled(intro.short);
const email = filled(identity.email);
const socials = activeSocials();

/**
 * Social glyphs, drawn here rather than pulled from an icon font.
 * Font Awesome would be ~30KB over the network to draw two shapes; these are
 * two path strings. Keyed by `network` from src/config/site.ts.
 */
const ICON: Record<string, string> = {
  GitHub:
    'M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.2 11.39.6.11.82-.26.82-.58v-2.2c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.12-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.81 5.65-5.49 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z',
  LinkedIn:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z',
  X: 'M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z',
  Link: 'M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71',
};
---

<div class="hero">
  <div class="shell hero__inner">
    {
      /* Before the words in the source, which is what lets it float on a
        narrow screen — a float only pushes content that comes after it. The
        wide layout puts it back in the second column by grid placement. */
    }
    <div class="hero__figure">
      <div class="portrait">
        <Image
          class="portrait__img"
          src={portrait}
          alt={filled(identity.portraitAlt) ?? `${identity.name}`}
          widths={[240, 320, 480, 640]}
          sizes="(min-width: 60rem) 22rem, (min-width: 30rem) 13rem, 7rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <div class="hero__words">
      <h1 class="masthead hero__name">{identity.name}</h1>

      {role && <p class="hero__role">{role}</p>}

      {statement && <p class="hero__statement">{statement}</p>}

      <div class="hero__actions">
        <a href="/blog/" class="btn btn-solid">
          Read the rebuilds
          <span aria-hidden="true">&#8594;</span>
        </a>
        {
          email && (
            <a href={`mailto:${email}`} class="btn">
              Get in touch
            </a>
          )
        }
      </div>

      {
        socials.length > 0 && (
          <div class="hero__foot">
            {socials.length > 0 && (
              <ul class="hero__socials">
                {socials.map((social) => (
                  <li>
                    <a
                      href={social.href}
                      class="hero__social"
                      rel="me noopener"
                      target="_blank"
                      aria-label={`${identity.shortName} on ${social.network}`}
                    >
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d={ICON[social.network] ?? ICON.Link} />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        )
      }
    </div>
  </div>

  <div class="shell">
    <div class="colophon-strip">
      {
        /* The role is set under the name a few lines up. Repeating it here
          states one thing twice on a single screen. */
      }
      {location && <span class="label colophon-strip__item">{location}</span>}

      {
        features.localClock && (
          <span
            class="label colophon-strip__item"
            data-local-time
            data-tz={identity.timezone}
            hidden
          />
        )
      }

      {
        availability.show && (
          <span class="label colophon-strip__item colophon-strip__status">
            <span
              class="colophon-strip__mark"
              data-open={availability.open ? 'true' : 'false'}
              aria-hidden="true"
            />
            {availability.open ? availability.label : availability.labelClosed}
          </span>
        )
      }

      {
        /* No address here. "Get in touch" above is the mailto, and the footer
          prints the address itself in full on every page. That printed copy is
          the one that matters: a bare mailto: hands the visitor to whatever the
          OS registered as its mail handler, so someone reading Gmail in a
          browser gets Outlook, or gets nothing, with no way back to the
          address. Do not remove it from the footer without putting the visible
          address somewhere else. */
      }
    </div>
  </div>
</div>

<style>
  /* A faint dot grid and a single soft wash of accent, both only on the first
     screen. It is the cheapest way to stop a page reading as a blank document,
     and it stops at the hero so the content below stays plain.

     ONE wash, in ONE hue, and the dots stay --rule grey. Both are
     load-bearing. The corner-glow-plus-dot-grid hero is common enough that
     only the details distinguish one from another, and the usual way it is
     done — a wash in each corner, in two different hues, over accent-tinted
     dots — is exactly what makes it read as a template. Restraint here is the
     whole differentiation: a second hue, or dots in the accent, throws it
     away. */
  .hero {
    position: relative;
    padding-top: clamp(2.5rem, 1.8rem + 3vw, 5rem);
    padding-bottom: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      radial-gradient(circle at 12% 8%, var(--hero-wash) 0%, transparent 46%),
      radial-gradient(currentColor 1px, transparent 1px);
    background-size:
      100% 100%,
      26px 26px;
    color: var(--rule);
    opacity: 0.9;
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }

  /* Two layouts, not one stacked version of the other.
     Wide: two columns, the photograph in the second.
     Narrow: the photograph sits in the text and the words wrap round it, the
     way a portrait sits in a printed column. Stacking it instead put a square
     the full width of the screen between the reader and the page. */
  .hero__inner {
    display: flow-root; /* contains the float below */
  }

  @media (min-width: 60rem) {
    .hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(2.25rem, 1.5rem + 3vw, 4rem);
      align-items: center;
    }
    /* Source order is figure → words, so both need placing. */
    .hero__words {
      grid-column: 1;
      grid-row: 1;
    }
    .hero__figure {
      grid-column: 2;
      grid-row: 1;
    }
  }

  .hero__name {
    margin-top: 0;
  }

  .hero__role {
    margin-top: 0.35rem;
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink-muted);
  }

  .hero__statement {
    margin-top: clamp(1.1rem, 0.9rem + 0.8vw, 1.6rem);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--ink-muted);
    max-width: 54ch;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 1.2rem + 1vw, 2.1rem);
  }

  .hero__foot {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(1.75rem, 1.4rem + 1.2vw, 2.4rem);
  }

  .hero__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    background: var(--paper-raised);
    color: var(--ink-muted);
    transition:
      color var(--dur-hover) var(--ease),
      border-color var(--dur-hover) var(--ease),
      transform var(--dur-hover) var(--ease);
  }
  .hero__social svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }
  .hero__social:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__social:hover {
      transform: translateY(-2px);
    }
  }

  /* ── the figure ───────────────────────────────────────────────────────── */

  .hero__figure {
    margin: 0;
    justify-self: center;
  }

  @media (min-width: 60rem) {
    .hero__figure {
      width: 100%;
    }
  }

  /* The photograph.

     The source is a formal headshot on pure white. Dropped straight onto a
     near-white card it would have no edge at all, so the frame does the work:
     a rounded card with a hairline, a raised ground and a lift shadow. The
     white background then reads as part of the composition rather than as a
     missing cut-out. */
  .portrait {
    position: relative;
    width: min(100%, 22rem);
    margin-inline: auto;
  }

  .portrait__img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
  }

  /* The name sets beside the photograph and the statement runs on under it.
     Sized so the name breaks over two lines next to it rather than colliding
     with it: ~104px against 320px of text at 360px, leaving ~195px, and
     "Samyamoy" is ~158px. Stacking it instead put a square the full width of
     the screen between the reader and the first sentence. */
  @media (max-width: 59.9375rem) {
    .hero__figure {
      float: right;
      margin: 0.25rem 0 1rem clamp(1rem, 0.5rem + 2vw, 2rem);
    }
    .portrait {
      width: clamp(6.5rem, 4rem + 11vw, 13rem);
      margin-inline: 0;
    }
  }

  .colophon-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }

  .colophon-strip__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .colophon-strip__status {
    color: var(--ink-muted);
  }

  .colophon-strip__mark {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--ink-faint);
    background: transparent;
  }
  .colophon-strip__mark[data-open='true'] {
    border-color: var(--accent);
    background: var(--accent);
  }
</style>

<script>
  /**
   * Fills in the site's local time, then keeps it honest on the minute.
   * Rendered hidden and revealed only once a real value exists, so a
   * JavaScript-free visit shows a complete strip rather than an empty slot.
   */
  function startClock() {
    const el = document.querySelector<HTMLElement>('[data-local-time]');
    if (!el) return;

    const timeZone = el.dataset.tz;
    if (!timeZone) return;

    let formatter: Intl.DateTimeFormat;
    try {
      formatter = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit',
        minute: '2-digit',
        timeZone,
        timeZoneName: 'short',
      });
    } catch {
      return; // an invalid IANA zone in the config — fail quietly
    }

    const tick = () => {
      el.textContent = formatter.format(new Date());
      el.hidden = false;
    };

    tick();
    const msToNextMinute = 60_000 - (Date.now() % 60_000);
    window.setTimeout(() => {
      tick();
      window.setInterval(tick, 60_000);
    }, msToNextMinute);
  }

  startClock();
  document.addEventListener('astro:after-swap', startClock);
</script>
