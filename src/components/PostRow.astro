---
import { Image } from 'astro:assets';
import type { BlogEntry } from '../lib/content';
import { formatDate, isoDate, readingTime, tagSlug } from '../lib/content';

interface Props {
  entry: BlogEntry;
  /** Hide the description on dense index pages. */
  compact?: boolean;
  /**
   * The heading level for the post title, which depends on what wraps it.
   *
   * Default h3 is right on the homepage, where the row sits under a "Writing"
   * <h2>. On /blog/ and /blog/tags/<tag>/ the section heading IS the <h1>, so
   * an h3 there skips a level and the page's outline reads as though a heading
   * went missing. That matters more than usual here: the cards carry several
   * links each, so heading navigation is how a screen-reader user skims the
   * list without tabbing through every tag.
   */
  level?: 'h2' | 'h3';
}

const { entry, compact = false, level = 'h3' } = Astro.props;
const { title, description, pubDate, tags, draft, cover, coverAlt } = entry.data;
const href = `/blog/${entry.id}/`;
const Heading = level;
---

<article class="row post-row">
  <div class="post-row__main">
    <Heading class="row-title">
      <a href={href} class="row-link">{title}</a>
      {draft && <span class="post-row__draft label">draft</span>}
    </Heading>

    {!compact && <p class="post-row__desc">{description}</p>}

    <div class="post-row__meta">
      <time class="label tnum" datetime={isoDate(pubDate)}>
        {formatDate(pubDate)}
      </time>
      {
        /* Telling someone what a post costs them is the cheapest way to get it
          read. An unlabelled wall of text is the thing people bounce off. */
      }
      <span class="label post-row__time">{readingTime(entry.body)}</span>
    </div>

    {
      tags.length > 0 && (
        <ul class="post-row__tags">
          {/* Each tag goes to its own page. Safe inside a card whose whole
            surface is already a link: global.css gives `.row a:not(.row-link)`
            a z-index above the .row-link overlay, so these stay clickable and
            the rest of the card still opens the post. */}
          {tags.map((tag) => (
            <li>
              <a href={`/blog/tags/${tagSlug(tag)}/`} class="tag tag-link">
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      cover && (
        <a href={href} class="post-row__thumb" tabindex="-1" aria-hidden="true">
          <Image src={cover} alt={coverAlt ?? ''} width={280} densities={[1, 2]} />
        </a>
      )
    }
  </div>
</article>

<style>
  /* The card is just chrome now — .post-row__main does the layout, because
     the thumbnail moved inside it (see below). One child, so no grid columns
     needed here. */

  /* A grid, not the flex row this used to be, so the thumbnail can be placed
     by name instead of by source order. Mobile-first: title, description,
     meta and tags each get their own row in a single column. When a cover
     exists, `:has()` reassigns the layout — see the two variants below. */
  .post-row__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'title' 'desc' 'meta' 'tags';
    align-items: start;
  }

  /* Medium's mobile list puts a small, uncropped thumbnail beside the byline
     rather than giving it a full-width row of its own — the version this
     replaced put a 200×120 picture below the tags, which is a whole extra
     screenful of scroll for a card that is otherwise four lines of text. The
     thumbnail rides next to the date/read-time line instead; tags stay
     full-width below both, since a wrapped tag list next to a shrinking
     picture would fight it for room. */
  .post-row__main:has(.post-row__thumb) {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'title title' 'desc desc' 'meta thumb' 'tags tags';
    column-gap: 0.75rem;
  }

  .row-title {
    grid-area: title;
  }

  /* `auto`, not a fixed column, on the desktop variant below: the frame is
     only as wide as the picture needs, so a portrait figure gives its unused
     width back to the text instead of sitting in the middle of an empty
     12rem lane. From 60rem the thumbnail goes back to spanning the whole
     card at the right, the way it always has — there is a whole empty
     column to fill there, so the small byline-height version would just
     leave it half empty. */
  @media (min-width: 60rem) {
    .post-row__main:has(.post-row__thumb) {
      grid-template-areas: 'title thumb' 'desc thumb' 'meta thumb' 'tags thumb';
      column-gap: 1.25rem;
    }
  }

  .post-row__desc {
    grid-area: desc;
    margin-top: 0.5rem;
    color: var(--ink-muted);
    max-width: 56ch;
    font-size: var(--text-base);
  }

  /* Date, cost, subject — the three things somebody uses to decide, on one
     line rather than scattered around the row. */
  .post-row__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    margin-top: 0.9rem;
    color: var(--ink-faint);
  }

  .post-row__time {
    color: var(--ink-faint);
  }

  .post-row__tags {
    grid-area: tags;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
  }

  /* A cover here is a figure, not a photograph: the Transformer architecture
     is 1142×1266, a loss curve is wide and short. Two things follow.

     The height is capped, because a portrait cover sized by its own
     proportions makes the card twice as tall as the words in it and the
     index stops being scannable — which is the whole reason the thumbnail is
     there. The cap sits below the height of the shortest card's text, so the
     picture never sets the card's height.

     The frame is `fit-content`, so it hugs whatever shape comes out of that.
     A fixed box was tried and is wrong in both directions: `contain` leaves
     bars down the sides of a portrait figure, and `cover` crops a diagram,
     which throws away the half that carried the point.

     **The caps are in px, and that is deliberate — they were in rem and it was
     a bug.** Chrome on Android has an accessibility text-scaling slider that
     raises the default font size, which is what `1rem` resolves to, so every
     rem length on the page grew with it. Measured at 390px with the slider at
     150%: the thumbnail went 173×192 → 260×288 inside a card that had itself
     shrunk to 330px, because the bigger type pushed the padding out. The
     picture ate the card, and it only ever happened on a phone, which is why
     it took a screenshot to find. A reader asking for larger *text* has not
     asked for a larger *picture*, and the cap is a statement about the
     picture's visual weight, so both sides of it belong in the same units the
     image's own intrinsic size is in.

     Below 60rem it now rides beside the meta line instead of taking a row of
     its own — see `.post-row__main:has(.post-row__thumb)` above — so it is
     capped much smaller there, closer to an avatar than a figure. It grows
     back to the desktop size once it has the whole right-hand column to
     itself. */
  .post-row__thumb {
    grid-area: thumb;
    display: block;
    width: fit-content;
    align-self: center;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .post-row__thumb img {
    display: block;
    width: auto;
    max-width: 64px;
    max-height: 64px;
    transition: transform var(--dur-reveal) var(--ease);
  }
  .row:hover .post-row__thumb img {
    transform: scale(1.03);
  }

  @media (min-width: 60rem) {
    .post-row__thumb {
      /* .row is baseline-aligned; the frame belongs at the top of the card.
         `end` so that if the auto column ever resolves wider than the
         picture, the slack falls between the two columns rather than showing
         as a gap against the card's right edge. */
      align-self: start;
      justify-self: end;
      margin-top: 0.35rem;
    }
    .post-row__thumb img {
      max-width: 192px;
      max-height: 160px;
    }
  }

  .post-row__draft {
    color: var(--ink-faint);
    vertical-align: middle;
    margin-left: 0.6rem;
  }
</style>
