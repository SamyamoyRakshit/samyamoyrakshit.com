---
/**
 * A section of the page.
 *
 * On wide screens the heading sits out in a left margin and the content runs
 * beside it, so the page reads as a set object rather than a stack of
 * full-width bands. Below 64rem the heading folds on top.
 *
 * Unnumbered: nothing on this site is a sequence. You can read the rebuilds
 * without the work, and either without the writing.
 */
interface Props {
  title: string;
  /** Optional one-line gloss under the heading, for sections that need one. */
  note?: string;
  /** Optional link at the foot of the section, e.g. "All work". */
  moreHref?: string;
  moreLabel?: string;
  /** Renders the title as <h1> instead of <h2> — for interior page headers. */
  level?: 'h1' | 'h2';
}

const { title, note, moreHref, moreLabel, level = 'h2' } = Astro.props;
const Heading = level;
---

<section class="section reveal">
  <div class="shell section__grid">
    <div class="section__rail">
      <Heading class="section__title">{title}</Heading>
      {note && <p class="section__note">{note}</p>}
    </div>

    <div class="section__body">
      <slot />

      {
        moreHref && (
          <a href={moreHref} class="label section__more">
            {moreLabel ?? 'See all'}
            <span aria-hidden="true">&#8594;</span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: calc(var(--section-gap) * 0.55);
  }

  .section__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .section__grid {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
    .section__rail {
      position: sticky;
      top: 2.5rem;
      align-self: start;
    }
  }

  .section__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    color: var(--ink);
  }

  .section__note {
    margin-top: 0.5rem;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-faint);
    max-width: 30ch;
  }

  .section__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 2rem;
    padding-block: 0.6rem;
    min-height: 44px;
    color: var(--ink-muted);
    border-top: 1px solid var(--rule);
    width: 100%;
    transition: color var(--dur-hover) var(--ease);
  }
  .section__more:hover {
    color: var(--accent);
  }
  .section__more span {
    transition: transform var(--dur-hover) var(--ease);
  }
  .section__more:hover span {
    transform: translateX(0.25rem);
  }
</style>
