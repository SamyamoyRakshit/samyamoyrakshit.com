---
/**
 * Live figures for the positional-encoding post.
 *
 * One component, fourteen figures, picked by `name`:
 *
 *   <PeFigure name="minute" />
 *
 * The markup here is only the frame of each figure — controls, readouts, an
 * empty <svg> or <canvas>. Everything drawn inside is built by
 * `pe-figures.js`, which looks for each figure by id and skips the ones that
 * are not on the page. That is why the styles are `is:global`: Astro's scoped
 * styles do not reach elements a script creates.
 *
 * Colours: surfaces, ink and rules are the site tokens. The six data colours
 * (--sin, --cos, --shift and the heatmap's --neg / --mid / --pos) are declared
 * here with light-dark(), so they follow the theme toggle like everything else.
 *
 * Symbols in table headers go through KaTeX at build time, the same as the
 * `$...$` in the post, so a θ in a figure's table matches the θ in the text.
 */
import katex from 'katex';

const tex = (src: string) => katex.renderToString(src, { throwOnError: true });

interface Props {
  name:
    | 'circle'
    | 'minute'
    | 'speeds'
    | 'three-hands'
    | 'binary'
    | 'hand-one'
    | 'dials'
    | 'wavelengths'
    | 'two-numbers'
    | 'heat'
    | 'rotate'
    | 'block'
    | 'dot'
    | 'look';
}
const { name } = Astro.props;
---

{name === 'circle' && (
  <figure class="pe">
    <div class="legend">
      <span>
        <i class="sw sw-sin" />
        height = sin θ
      </span>
      <span>
        <i class="sw sw-cos" />
        sideways = cos θ
      </span>
      <span>the hand has length 1</span>
    </div>
    <div class="split">
      <svg
        id="c1-dial"
        class="dial-lg"
        viewBox="0 0 240 240"
        role="img"
        aria-label="A hand of length 1 on a circle. A teal bar shows the height of its tip, an orange bar shows its sideways position."
      />
      <div class="chartbox" id="c1-box">
        <svg
          id="c1-wave"
          class="chart"
          role="img"
          aria-label="Height and sideways position of the tip plotted against the angle, over two full turns. Both are waves that repeat every 2 pi."
        />
      </div>
    </div>
    <div class="controls">
      <button class="pbtn" type="button" id="c1-play" aria-pressed="false">
        Play
      </button>
      <div class="slider">
        <label for="c1-theta">Turn the hand</label>
        <input type="range" id="c1-theta" min="0" max="12.56" step="0.01" value="0.64" />
      </div>
    </div>
    <dl class="readout">
      <div>
        <dt>angle θ</dt>
        <dd id="c1-r-ang" />
      </div>
      <div>
        <dt>same angle in turns</dt>
        <dd id="c1-r-turn" />
      </div>
      <div>
        <dt>height, sin θ</dt>
        <dd id="c1-r-sin" />
      </div>
      <div>
        <dt>sideways, cos θ</dt>
        <dd id="c1-r-cos" />
      </div>
      <div>
        <dt>height² + sideways²</dt>
        <dd id="c1-r-sq" />
      </div>
    </dl>
    <figcaption>
      One hand, two numbers. After 2π the hand is back where it started, so both curves
      repeat.
    </figcaption>
  </figure>
)}

{name === 'minute' && (
  <figure class="pe">
    <p class="fig-title">The minute hand, starting at 12 o’clock</p>
    <p class="fig-sub">
      Its speed never changes: ω = 2π ÷ 60 ≈ 0.1047 radians per minute.
    </p>
    <div class="legend">
      <span>
        <i class="sw sw-shift" />
        angle turned so far, θ
      </span>
    </div>
    <div class="side">
      <svg
        id="ck-svg"
        class="clock"
        viewBox="0 0 260 260"
        role="img"
        aria-label="A wall clock face with one hand, the minute hand. A shaded wedge marks the angle the hand has turned since 12 o’clock."
      />
      <div class="tbl">
        <table>
          <thead>
            <tr>
              <th align="right">
                <Fragment set:html={tex('t')} />, minutes
              </th>
              <th align="right">
                <Fragment set:html={tex('\\theta = \\omega \\times t')} />
              </th>
              <th align="right">in degrees</th>
              <th>the hand points at</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="num" align="right">
                0
              </td>
              <td class="num" align="right">
                0 rad
              </td>
              <td class="num" align="right">
                0°
              </td>
              <td>12</td>
            </tr>
            <tr>
              <td class="num" align="right">
                15
              </td>
              <td class="num" align="right">
                1.571 rad
              </td>
              <td class="num" align="right">
                90°
              </td>
              <td>3</td>
            </tr>
            <tr>
              <td class="num" align="right">
                20
              </td>
              <td class="num" align="right">
                2.094 rad
              </td>
              <td class="num" align="right">
                120°
              </td>
              <td>4</td>
            </tr>
            <tr>
              <td class="num" align="right">
                30
              </td>
              <td class="num" align="right">
                3.142 rad
              </td>
              <td class="num" align="right">
                180°
              </td>
              <td>6</td>
            </tr>
            <tr>
              <td class="num" align="right">
                60
              </td>
              <td class="num" align="right">
                6.283 rad
              </td>
              <td class="num" align="right">
                360°
              </td>
              <td>12 again</td>
            </tr>
            <tr>
              <td class="num" align="right">
                75
              </td>
              <td class="num" align="right">
                7.854 rad
              </td>
              <td class="num" align="right">
                450°
              </td>
              <td>3 again</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="controls">
      <button class="pbtn" type="button" id="ck-play" aria-pressed="false">
        Play
      </button>
      <div class="slider">
        <label for="ck-t">
          Minutes passed, <var>t</var>
        </label>
        <input type="range" id="ck-t" min="0" max="120" step="1" value="20" />
        <output id="ck-out" for="ck-t" />
      </div>
      <span class="chips">
        Jump to
        <button class="pbtn" type="button" data-ck="15">
          15
        </button>
        <button class="pbtn" type="button" data-ck="20">
          20
        </button>
        <button class="pbtn" type="button" data-ck="30">
          30
        </button>
        <button class="pbtn" type="button" data-ck="60">
          60
        </button>
        <button class="pbtn" type="button" data-ck="75">
          75
        </button>
      </span>
    </div>
    <dl class="readout">
      <div>
        <dt>
          angle turned, θ = ω × <var>t</var>
        </dt>
        <dd id="ck-r-th" />
      </div>
      <div>
        <dt>
          full turns so far, <var>t</var> ÷ 60
        </dt>
        <dd id="ck-r-turn" />
      </div>
    </dl>
    <p class="note-live" id="ck-note" aria-live="polite" />
    <figcaption>
      The angle keeps growing, but after 60 minutes the hand is back at the 12 and
      repeats.
    </figcaption>
  </figure>
)}

{name === 'speeds' && (
  <figure class="pe">
    <p class="fig-title">Three hands, three speeds</p>
    <p class="fig-sub">
      Height of each hand over 20 steps. The shaded band is one full turn, the wavelength.
    </p>
    <div class="speed-rows" id="c2-rows" />
    <div class="controls">
      <button class="pbtn" type="button" id="c2-play" aria-pressed="false">
        Play
      </button>
      <div class="slider">
        <label for="c2-t">
          Time <var>t</var>
        </label>
        <input type="range" id="c2-t" min="0" max="20" step="0.05" value="4" />
        <output id="c2-out" for="c2-t" />
      </div>
    </div>
    <figcaption>
      Same time, different speeds. Halving ω doubles the wavelength.
    </figcaption>
  </figure>
)}

{name === 'three-hands' && (
  <figure class="pe">
    <p class="fig-title">Three hands, one time</p>
    <p class="fig-sub">
      Counting from 12:00:00. The clock reads <b id="c3k-time" />.
    </p>
    <div class="side">
      <svg
        id="c3k-svg"
        class="clock"
        viewBox="0 0 260 260"
        role="img"
        aria-label="A wall clock with an hour hand, a minute hand and a second hand, each turning at its own speed."
      />
      <div class="tbl">
        <table>
          <thead>
            <tr>
              <th>hand</th>
              <th align="right">one full turn takes</th>
              <th align="right">against the hand before</th>
              <th align="right">turns so far</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="nw">
                <i class="key key-sec" />
                second
              </td>
              <td class="num" align="right">
                60 s
              </td>
              <td class="num" align="right" />
              <td class="num" align="right" id="c3k-s" />
            </tr>
            <tr>
              <td class="nw">
                <i class="key key-min" />
                minute
              </td>
              <td class="num" align="right">
                3,600 s
              </td>
              <td class="num" align="right">
                × 60
              </td>
              <td class="num" align="right" id="c3k-m" />
            </tr>
            <tr>
              <td class="nw">
                <i class="key key-hr" />
                hour
              </td>
              <td class="num" align="right">
                43,200 s
              </td>
              <td class="num" align="right">
                × 12
              </td>
              <td class="num" align="right" id="c3k-h" />
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <div class="controls">
      <button class="pbtn" type="button" id="c3k-play" aria-pressed="false">
        Play
      </button>
      <div class="slider">
        <label for="c3k-t">Seconds passed</label>
        <input type="range" id="c3k-t" min="0" max="3600" step="1" value="1570" />
        <output id="c3k-out" for="c3k-t" />
      </div>
    </div>
    <figcaption>
      Drag across the whole hour: 60 turns, 1 turn and one twelfth of a turn. Play runs at
      30 times real speed.
    </figcaption>
  </figure>
)}

{name === 'binary' && (
  <figure class="pe">
    <p class="fig-title">Counting from 0 to 15 in binary</p>
    <p class="fig-sub">One row per bit. A filled square is a 1.</p>
    <div class="scroll-x">
      <svg
        id="c3-svg"
        viewBox="0 0 324 92"
        width="324"
        height="92"
        role="img"
        aria-label="The numbers 0 to 15 in binary. The lowest bit flips every step, the next every 2 steps, the next every 4, the highest every 8."
      />
    </div>
    <figcaption>
      Each row is a square wave whose wavelength is double the row above.
    </figcaption>
  </figure>
)}

{name === 'hand-one' && (
  <figure class="pe">
    <p class="fig-title">
      Hand 1 of a model with d<sub>model</sub> = 4
    </p>
    <p class="fig-sub">Its speed never changes: ω = 0.01 radians per position.</p>
    <div class="legend">
      <span>
        <i class="sw sw-sin" />
        height = sin θ, stored in column 2
      </span>
      <span>
        <i class="sw sw-cos" />
        sideways = cos θ, stored in column 3
      </span>
    </div>
    <div class="side">
      <svg
        id="p1-svg"
        class="dial-lg"
        viewBox="0 0 240 240"
        role="img"
        aria-label="A slow hand on a circle. It starts pointing right and turns anticlockwise by 0.01 radians for each position."
      />
      <div class="tbl">
        <table>
          <thead>
            <tr>
              <th align="right">
                <Fragment set:html={tex('\\mathit{pos}')} />
              </th>
              <th align="right">
                <Fragment set:html={tex('\\theta = 0.01 \\times \\mathit{pos}')} />
              </th>
              <th align="right">turns</th>
              <th align="right">
                <Fragment set:html={tex('\\sin\\theta')} />
              </th>
              <th align="right">
                <Fragment set:html={tex('\\cos\\theta')} />
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="num" align="right">
                0
              </td>
              <td class="num" align="right">
                0 rad
              </td>
              <td class="num" align="right">
                0
              </td>
              <td class="num" align="right">
                0.0000
              </td>
              <td class="num" align="right">
                1.0000
              </td>
            </tr>
            <tr>
              <td class="num" align="right">
                34
              </td>
              <td class="num" align="right">
                0.34 rad
              </td>
              <td class="num" align="right">
                0.05
              </td>
              <td class="num" align="right">
                0.3335
              </td>
              <td class="num" align="right">
                0.9428
              </td>
            </tr>
            <tr>
              <td class="num" align="right">
                157
              </td>
              <td class="num" align="right">
                1.57 rad
              </td>
              <td class="num" align="right">
                0.25
              </td>
              <td class="num" align="right">
                1.0000
              </td>
              <td class="num" align="right">
                0.0008
              </td>
            </tr>
            <tr>
              <td class="num" align="right">
                314
              </td>
              <td class="num" align="right">
                3.14 rad
              </td>
              <td class="num" align="right">
                0.50
              </td>
              <td class="num" align="right">
                0.0016
              </td>
              <td class="num" align="right">
                −1.0000
              </td>
            </tr>
            <tr>
              <td class="num" align="right">
                628
              </td>
              <td class="num" align="right">
                6.28 rad
              </td>
              <td class="num" align="right">
                1.00
              </td>
              <td class="num" align="right">
                −0.0032
              </td>
              <td class="num" align="right">
                1.0000
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="vecline" id="p1-vec" aria-live="off" />
    <div class="controls">
      <button class="pbtn" type="button" id="p1-play" aria-pressed="false">
        Play
      </button>
      <div class="slider">
        <label for="p1-pos">
          Position <var>pos</var>
        </label>
        <input type="range" id="p1-pos" min="0" max="700" step="1" value="34" />
        <output id="p1-out" for="p1-pos" />
      </div>
      <span class="chips">
        Jump to
        <button class="pbtn" type="button" data-p1="34">
          34
        </button>
        <button class="pbtn" type="button" data-p1="157">
          157
        </button>
        <button class="pbtn" type="button" data-p1="314">
          314
        </button>
        <button class="pbtn" type="button" data-p1="628">
          628
        </button>
      </span>
    </div>
    <dl class="readout">
      <div>
        <dt>
          angle, θ = 0.01 × <var>pos</var>
        </dt>
        <dd id="p1-r-th" />
      </div>
      <div>
        <dt>
          full turns so far, <var>pos</var> ÷ 628.3
        </dt>
        <dd id="p1-r-turn" />
      </div>
    </dl>
    <figcaption>
      157, 314 and 628 are this hand’s quarter turn, half turn and full turn.
    </figcaption>
  </figure>
)}

{name === 'dials' && (
  <figure class="pe">
    <div class="legend">
      <span>
        <i class="sw sw-sin" />
        height, goes in the even column
      </span>
      <span>
        <i class="sw sw-cos" />
        sideways, goes in the odd column
      </span>
    </div>
    <div class="dials" id="c4-dials" />
    <p class="vecline" id="c4-vec" aria-live="off" />
    <div class="controls">
      <button class="pbtn" type="button" id="c4-play" aria-pressed="false">
        Play
      </button>
      <button class="pbtn" type="button" id="c4-dec" aria-label="One position back">
        −1
      </button>
      <button class="pbtn" type="button" id="c4-inc" aria-label="One position forward">
        +1
      </button>
      <div class="slider">
        <label for="c4-pos">
          Position <var>pos</var>
        </label>
        <input type="range" id="c4-pos" min="0" max="100" step="1" value="34" />
        <output id="c4-out" for="c4-pos" />
      </div>
      <span class="chips">
        Jump to
        <button class="pbtn" type="button" data-jump="0">
          0
        </button>
        <button class="pbtn" type="button" data-jump="34">
          34
        </button>
        <button class="pbtn" type="button" data-jump="44">
          44
        </button>
        <button class="pbtn" type="button" data-jump="63">
          63
        </button>
      </span>
    </div>
    <figcaption>
      Four hands for d_model = 8. Under each dial are the two columns that hand fills.
    </figcaption>
  </figure>
)}

{name === 'wavelengths' && (
  <figure class="pe">
    <p class="fig-title">Wavelength of every hand</p>
    <p class="fig-sub">
      Up the side: positions needed for one full turn. Across the bottom: hand number.
    </p>
    <div class="chartbox" id="c5-box">
      <svg
        id="c5-svg"
        class="chart"
        role="img"
        aria-label="Wavelength of each hand. On a log scale the points fall on a straight line between 2 pi and 10000 times 2 pi."
      />
      <div class="tip-box" id="c5-tip" hidden />
    </div>
    <div class="controls">
      <span class="seg" id="c5-d">
        <span>
          <var>d</var>
          <sub>model</sub>
        </span>
        <span>
          <button class="pbtn" type="button" data-d="8" aria-pressed="true">
            8
          </button>
          <button class="pbtn" type="button" data-d="64" aria-pressed="false">
            64
          </button>
          <button class="pbtn" type="button" data-d="512" aria-pressed="false">
            512
          </button>
        </span>
      </span>
      <span class="seg" id="c5-scale">
        Vertical scale
        <span>
          <button class="pbtn" type="button" data-scale="log" aria-pressed="true">
            Log
          </button>
          <button class="pbtn" type="button" data-scale="lin" aria-pressed="false">
            Linear
          </button>
        </span>
      </span>
    </div>
    <p class="note-live" id="c5-note" aria-live="polite" />
    <figcaption>
      The two horizontal lines are the paper’s limits, 2π and 10000 · 2π. Hover or tap a
      point for its value.
    </figcaption>
  </figure>
)}

{name === 'two-numbers' && (
  <figure class="pe">
    <div class="side">
      <svg
        viewBox="0 0 300 240"
        width="300"
        class="rot-dial"
        role="img"
        aria-label="Two hands, A and B, with their tips at the same height 0.6 but on opposite sides of the circle."
      >
        <line x1="30" y1="125" x2="270" y2="125" class="axis" />
        <line x1="150" y1="20" x2="150" y2="230" class="axis" />
        <circle cx="150" cy="125" r="95" class="rim" />
        <line x1="40" y1="68" x2="260" y2="68" class="ref" />
        <line x1="150" y1="125" x2="226" y2="125" class="seg-cos" />
        <line x1="150" y1="125" x2="74" y2="125" class="seg-cos" />
        <line x1="226" y1="125" x2="226" y2="68" class="seg-sin" />
        <line x1="74" y1="125" x2="74" y2="68" class="seg-sin" />
        <line x1="150" y1="125" x2="226" y2="68" class="hand" />
        <line x1="150" y1="125" x2="74" y2="68" class="hand" />
        <circle cx="226" cy="68" r="6" class="tip" />
        <circle cx="74" cy="68" r="6" class="tip" />
        <text x="150" y="60" text-anchor="middle" class="lbl">
          same height, 0.6
        </text>
        <text x="243" y="62" text-anchor="middle" class="lbl-strong">
          A
        </text>
        <text x="57" y="62" text-anchor="middle" class="lbl-strong">
          B
        </text>
        <text x="188" y="142" text-anchor="middle" class="tick">
          +0.8
        </text>
        <text x="112" y="142" text-anchor="middle" class="tick">
          −0.8
        </text>
      </svg>
      <div class="tbl">
        <table>
          <thead>
            <tr>
              <th>hand</th>
              <th align="right">angle</th>
              <th align="right">
                <i class="sw sw-sin" />
                <Fragment set:html={tex('\\sin')} />
              </th>
              <th align="right">
                <i class="sw sw-cos" />
                <Fragment set:html={tex('\\cos')} />
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>A</td>
              <td class="num" align="right">
                0.64 rad (36.9°)
              </td>
              <td class="num" align="right">
                +0.6
              </td>
              <td class="num" align="right">
                +0.8
              </td>
            </tr>
            <tr>
              <td>B</td>
              <td class="num" align="right">
                2.50 rad (143.1°)
              </td>
              <td class="num" align="right">
                +0.6
              </td>
              <td class="num" align="right">
                −0.8
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <figcaption>
      Hands A and B are at the same height. Only the sideways position tells them apart.
    </figcaption>
  </figure>
)}

{name === 'heat' && (
  <figure class="pe">
    <div class="scale">
      <span>−1</span>
      <i />
      <span>+1</span>
      <span>&nbsp;grey is 0</span>
    </div>
    <div class="chartbox" id="c7-box">
      <canvas
        id="c7-canvas"
        role="img"
        aria-label="Heatmap of the positional encoding for 64 columns and 100 positions. Top rows flicker quickly from position to position. Bottom rows hardly change."
      />
      <div class="tip-box" id="c7-tip" hidden />
    </div>
    <div class="controls">
      <span class="seg" id="c7-n">
        Positions shown
        <span>
          <button class="pbtn" type="button" data-s="1" aria-pressed="true">
            First 100
          </button>
          <button class="pbtn" type="button" data-s="10" aria-pressed="false">
            First 1,000
          </button>
          <button class="pbtn" type="button" data-s="100" aria-pressed="false">
            First 10,000
          </button>
        </span>
      </span>
    </div>
