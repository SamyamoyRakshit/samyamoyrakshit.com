---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import PostRow from '../../components/PostRow.astro';
import { getBlogPosts } from '../../lib/content';
import { identity } from '../../config/site';

/**
 * The Bengali couplet used to run as a band under the masthead here, and it
 * has moved to /bn/. It is the argument for that section existing, so it sits
 * at the head of it rather than over a list of English essays. This page no
 * longer paints a Bengali glyph, which is why `preloadBengali` went with it.
 */

const posts = await getBlogPosts();
---

<Base title="Writing" description={`Notes and essays by ${identity.name}.`}>
  <Section title="Writing" level="h1">
    {
      posts.length > 0 ? (
        /* h2, not the default h3: the section heading above is this page's h1. */
        posts.map((entry) => <PostRow entry={entry} level="h2" />)
      ) : import.meta.env.DEV ? (
        /* Development only. A live page must never address its own maintainer. */
        <p class="empty">
          Nothing published yet. Add
          <code>src/content/blog/&lt;name&gt;/ARTICLE.md</code> and it will appear here
          and in the feed.
        </p>
      ) : null
    }

    {
      posts.length > 0 && (
        <a href="/rss.xml" class="label feed">
          RSS feed
        </a>
      )
    }
  </Section>
</Base>

<style>
  .empty {
    color: var(--ink-faint);
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }
  .empty code {
    color: var(--ink-muted);
  }

  .feed {
    display: inline-block;
    margin-top: 2rem;
    padding-block: 0.6rem;
    min-height: 44px;
    color: var(--ink-faint);
    transition: color var(--dur-hover) var(--ease);
  }
  .feed:hover {
    color: var(--accent);
  }
</style>
